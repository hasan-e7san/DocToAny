generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  uploaded
  queued
  parsing
  extracting
  formatting_output
  completed
  failed
  expired
  deleted
}

enum OutputType {
  JSON
  Markdown
  CSV
  Summary
}

enum MessageStatus {
  new
  reviewed
  resolved
}

model User {
  id              String         @id @default(cuid())
  name            String?
  email           String         @unique
  emailVerified   DateTime?
  passwordHash    String?
  image           String?
  triesUsed       Int            @default(0)
  triesLimit      Int            @default(5)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  accounts        Account[]
  sessions        Session[]
  documents       Document[]
  documentRuns    DocumentRun[]
  usageEvents     UsageEvent[]
  exports         Export[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Document {
  id                 String         @id @default(cuid())
  userId             String
  originalName       String
  fileType           String
  mimeType           String
  filePath           String?
  fileSize           Int
  status             DocumentStatus @default(uploaded)
  documentType       String?
  userInstructions   String?
  selectedOutputType OutputType
  rawText            String?
  extractedJson      String?
  formattedOutput    String?
  errorMessage       String?
  expiresAt          DateTime
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs               DocumentRun[]
  usageEvents        UsageEvent[]
  exports            Export[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([expiresAt])
}

model DocumentRun {
  id            String   @id @default(cuid())
  documentId    String
  userId        String
  modelName     String
  status        String
  inputTokens   Int?
  outputTokens  Int?
  costEstimate  Float?
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime @default(now())
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId])
}

model UsageEvent {
  id          String    @id @default(cuid())
  userId      String
  documentId  String?
  eventType   String
  units       Int       @default(1)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    MessageStatus @default(new)
  createdAt DateTime      @default(now())

  @@index([createdAt])
}

model Export {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  format     String
  filePath   String?
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([userId, createdAt])
}
